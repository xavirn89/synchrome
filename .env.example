# Synchrome client configuration — variable NAMES only, no real values.
# Copy to .env (gitignored). Both values are PUBLISHABLE: the anon key is designed to ship
# in clients and Row Level Security protects the data. Administrative secrets are never
# part of the client configuration and have no place in this file.

SUPABASE_URL=https://your-instance.example.com
SUPABASE_ANON_KEY=
