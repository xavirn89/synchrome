# Synchrome — environment variable NAMES only. Never commit real values.
# Copy to .env (gitignored) and fill in to run experiment E9 against the Supabase instance.

# --- 1. Client (Tauri app + tests): public ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- 2. Tests / local dev: secret, local only ---
# Leave empty if you want the E9 script to create the test users via the service role instead.
E9_TEST_EMAIL_A=
E9_TEST_PASSWORD_A=
E9_TEST_EMAIL_B=
E9_TEST_PASSWORD_B=

# --- 3. Migrations / admin: SECRET, never in the Tauri binary, never committed ---
# Used by the E9 script only to create/tear down experimental resources (bucket e9-experiments, temp tables).
SUPABASE_SERVICE_ROLE_KEY=
