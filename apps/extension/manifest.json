{
  "manifest_version": 3,
  "name": "Synchrome",
  "version": "0.1.0",
  "description": "Synchrome companion: links this browser profile to your Synchrome account and captures bookmark changes for the Synchrome app.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "nativeMessaging",
    "bookmarks",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Synchrome",
    "default_popup": "popup.html"
  }
}
