{
  "manifest_version": 3,
  "name": "Synchrome",
  "version": "1.0.3",
  "description": "Connect this browser to Synchrome for macOS to sync bookmarks and your installed extensions across your Macs.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "nativeMessaging",
    "bookmarks",
    "alarms",
    "management"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Synchrome",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
