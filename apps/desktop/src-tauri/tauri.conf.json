{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synchrome",
  "version": "1.0.0",
  "identifier": "com.synchrome.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Synchrome",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": { "../../extension/": "extension/" },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
